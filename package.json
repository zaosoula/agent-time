{
  "name": "ade-time-tracking",
  "version": "0.2.0-beta.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "pricing:check": "node scripts/check-pricing.ts",
    "typecheck": "vue-tsc --noEmit",
    "capture": "node src/capture/cli.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop:build": "node scripts/build-desktop.mjs",
    "beta:build": "node scripts/build-beta.mjs",
    "native:build": "mkdir -p .capture/bin && swiftc native/ActivityProbe.swift -o .capture/bin/activity-probe",
    "sidecars:build": "node scripts/package-sidecars.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.55.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
