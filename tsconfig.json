{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["node", "vite/client"], "lib": ["ES2023", "DOM"],
    "skipLibCheck": true, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts"]
}
