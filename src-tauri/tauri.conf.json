{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Time",
  "version": "0.2.0-beta.9",
  "identifier": "studio.ezyo.agenttime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Time",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/node",
      "binaries/agent-activity",
      "binaries/linear-keychain",
      "binaries/startup-item",
      "binaries/widget-snapshot"
    ],
    "resources": {
      "resources/capture/": "capture/",
      "resources/usage/": "usage/"
    },
    "macOS": {
      "files": {
        "PlugIns/AgentTimeWidget.appex": "widget/AgentTimeWidget.appex"
      }
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agenttime"]
      }
    }
  }
}
